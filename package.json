{
  "name": "syncedmap",
  "version": "0.1.1",
  "description": "Map-like local reads with optional Redis replication and coordinated operations",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --target es2015 --external ./redisLoader.cjs && node -e \"require('fs').copyFileSync('src/redisLoader.cjs','dist/redisLoader.cjs')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run test:consumers",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test:consumers": "bash scripts/verify-consumers.sh"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ioredis": "^5.8.2",
    "redlock": "5.0.0-beta.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0",
    "acorn": "^8.15.0"
  },
  "dependencies": {
    "uniquemutexmanager": "^0.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "ioredis": "^5.0.0",
    "redlock": "^5.0.0-beta.2"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "redlock": {
      "optional": true
    }
  }
}
